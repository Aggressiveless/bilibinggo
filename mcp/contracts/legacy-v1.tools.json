  {
    "name": "account_login_qrcode",
    "description": "获取当前登录二维码 PNG（对应扫码弹窗中的图）。\n\n须已在登录流程中（通常先 account_login）。返回图片 + 简短 job 元数据。\n二维码刷新后再次调用本工具取新图并展示给用户。码尚未生成时会报错。",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "account_login",
    "description": "扫码登录（对应侧栏「扫码登录」/重新扫码）。\n\n二维码就绪后返回 PNG 图片；登录 Job 仍在服务端继续。\n必须把图片展示给用户扫码，然后串行轮询 job_get 直至 success/error。\n换码用 account_login_qrcode；放弃用 account_login_cancel。\n已登录时勿盲目调用，除非用户明确要求重登。",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "account_login_cancel",
    "description": "关闭扫码/取消进行中的登录（对应扫码弹窗 ×）。\n\n仅当当前 Job 为 login 时有效。这不是通用「取消任务」按钮，不能取消抽奖/更新类 Job。",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "account_refresh",
    "description": "刷新账号（对应侧栏「刷新账号」）。\n\n仅重新拉取账号接口，不是重新扫码。网络异常恢复后可用；Cookie 失效应走 account_login。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "include_extras": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "account_logout",
    "description": "退出登录（对应侧栏「退出登录」）。\n\n清除本机登录态；响应不含 Cookie。退出后需登录的写操作会失败，应再走 account_login。",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "account_ack_at_unread",
    "description": "确认 @ 未读提示（对应账号区「知道了」）。\n\ncurrent 为当前未读数（与网页一致）。用于消除「@我的未读增加」提示。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "current": {
          "type": "integer"
        }
      },
      "required": [
        "current"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "job_refresh_watch",
    "description": "更新监控用户动态（对应网页「更新监控用户动态」）。\n\n会阻塞直到任务终态再返回。需已登录；日常同步监控源用此工具。",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "job_refresh_status",
    "description": "刷新任务状态（对应网页「刷新任务状态」）。\n\n会阻塞直到任务终态再返回。用于刷新活动开奖/参与状态等。",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "job_refresh_all",
    "description": "一键更新活动链接（对应网页「一键更新」）。\n\n会阻塞直到终态；耗时可能很长，且更易触发风控。仅在用户明确要求一键全量更新时使用；\n日常优先 job_refresh_source 单源更新。",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "job_refresh_source",
    "description": "更新此源/UP 合集（对应网页各源「更新此源」）。\n\n参数 source_id 须为有效数据源 ID。会阻塞直到终态。推荐的日常更新方式。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string"
        }
      },
      "required": [
        "source_id"
      ],
      "additionalProperties": false
    }
  },
  {
