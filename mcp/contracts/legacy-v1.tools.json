      "type": "object",
      "properties": {
        "job_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "auto_status_get",
