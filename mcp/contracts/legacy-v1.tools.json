  {
    "name": "job_get",
    "description": "读取当前 Job 状态/进度/结果（对应顶部进度条与结果横幅）。\n\n登录流程中串行轮询本工具查看 login_phase 与 state。\n其它 job_* 工具会等到终态才返回，一般不必中途轮询；若需看日志用 job_logs_get。",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "job_logs_get",
    "description": "读取任务日志摘要（对应网页任务日志坞）。\n\n可选 job_id；默认最近日志。limit 默认 200。",
